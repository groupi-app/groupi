{
  "name": "@groupi/shared",
  "version": "0.5.0",
  "description": "Shared business logic and hooks for Groupi web and mobile apps",
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./hooks": "./src/hooks/index.ts",
    "./utils": "./src/utils/index.ts",
    "./types": "./src/types/index.ts",
    "./platform": "./src/platform/index.ts",
    "./design": "./src/design/index.ts",
    "./design/themes": "./src/design/themes/index.ts",
    "./gdl": "./src/gdl/index.ts"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:run": "vitest run",
    "test:watch": "vitest --watch",
    "test:coverage": "vitest run --coverage",
    "clean": "rm -rf dist"
  },
  "peerDependencies": {
    "convex": "^1.0.0",
    "react": "^18.0.0 || ^19.0.0"
  },
  "dependencies": {
    "chrono-node": "^2.9.0",
    "clsx": "^2.1.1",
    "htmlparser2": "8.0.2",
    "tailwind-merge": "^3.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.0.0 || ^19.0.0",
    "@vitest/coverage-v8": "^4.0.17",
    "convex": "^1.16.0",
    "react": "^18.0.0 || ^19.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.0.0",
    "vitest": "^4.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/groupi-app/groupi.git",
    "directory": "packages/shared"
  },
  "keywords": [
    "react",
    "react-native",
    "convex",
    "hooks",
    "cross-platform"
  ],
  "author": "Groupi Team",
  "license": "GPL-3.0",
  "publishConfig": {
    "main": "dist/index.cjs",
    "module": "dist/index.js",
    "types": "dist/index.d.ts",
    "exports": {
      ".": {
        "import": {
          "types": "./dist/index.d.ts",
          "default": "./dist/index.js"
        },
        "require": {
          "types": "./dist/index.d.cts",
          "default": "./dist/index.cjs"
        }
      },
      "./hooks": {
        "import": {
          "types": "./dist/hooks/index.d.ts",
          "default": "./dist/hooks/index.js"
        },
        "require": {
          "types": "./dist/hooks/index.d.cts",
          "default": "./dist/hooks/index.cjs"
        }
      },
      "./utils": {
        "import": {
          "types": "./dist/utils/index.d.ts",
          "default": "./dist/utils/index.js"
        },
        "require": {
          "types": "./dist/utils/index.d.cts",
          "default": "./dist/utils/index.cjs"
        }
      },
      "./types": {
        "import": {
          "types": "./dist/types/index.d.ts",
          "default": "./dist/types/index.js"
        },
        "require": {
          "types": "./dist/types/index.d.cts",
          "default": "./dist/types/index.cjs"
        }
      },
      "./platform": {
        "import": {
          "types": "./dist/platform/index.d.ts",
          "default": "./dist/platform/index.js"
        },
        "require": {
          "types": "./dist/platform/index.d.cts",
          "default": "./dist/platform/index.cjs"
        }
      },
      "./design": {
        "import": {
          "types": "./dist/design/index.d.ts",
          "default": "./dist/design/index.js"
        },
        "require": {
          "types": "./dist/design/index.d.cts",
          "default": "./dist/design/index.cjs"
        }
      },
      "./design/themes": {
        "import": {
          "types": "./dist/design/themes/index.d.ts",
          "default": "./dist/design/themes/index.js"
        },
        "require": {
          "types": "./dist/design/themes/index.d.cts",
          "default": "./dist/design/themes/index.cjs"
        }
      },
      "./gdl": {
        "import": {
          "types": "./dist/gdl/index.d.ts",
          "default": "./dist/gdl/index.js"
        },
        "require": {
          "types": "./dist/gdl/index.d.cts",
          "default": "./dist/gdl/index.cjs"
        }
      }
    }
  },
  "type": "module"
}
