    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.2",
    "@vitejs/plugin-react": "^5.1.2",
    "@testing-library/react": "^16.3.1",
    "@testing-library/user-event": "^14.6.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@tailwindcss/postcss": "^4.1.16",
    "tailwindcss": "^4.1.16",
    "jsdom": "^27.4.0",
    "vite": "^7.3.1",
    "vitest": "^4.0.17",
    "typescript": "^5.9.3",
