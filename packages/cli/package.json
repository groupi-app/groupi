{
  "name": "@groupi/cli",
  "version": "0.2.0",
  "description": "Groupi event planning from the terminal",
  "type": "module",
  "license": "GPL-3.0",
  "bin": {
    "groupi": "bin/groupi.js"
  },
  "files": [
    "bin",
    "src",
    "README.md",
    "docs",
    "skills",
    "scripts/generate-reference.js"
  ],
  "engines": {
    "node": "^22.0.0 || ^24.0.0"
  },
  "scripts": {
    "type-check": "tsc --noEmit",
    "lint": "eslint .",
    "test:run": "vitest run",
    "test:package": "node scripts/test-package.js",
    "docs:generate": "node scripts/generate-reference.js",
    "docs:check": "node scripts/generate-reference.js --check",
    "prepack": "node scripts/generate-reference.js --check"
  },
  "dependencies": {
    "@inkjs/ui": "^2.0.0",
    "@napi-rs/keyring": "2.1.0",
    "commander": "^14.0.0",
    "ink": "^7.1.1",
    "marked": "14.0.0",
    "react": "19.2.0"
  },
  "devDependencies": {
    "@types/node": "^24.9.2",
    "@types/react": "19.2.14",
    "ink-testing-library": "^4.0.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
