{
  "planning": [
    {
      "identity": "organizer",
      "args": [
        "events",
        "create",
        "--title",
        "Dinner",
        "--request-id",
        "$EVENT_REQUEST_ID",
        "--format",
        "json"
      ]
    },
    {
      "identity": "organizer",
      "args": [
        "invites",
        "members",
        "send",
        "$EVENT_ID",
        "--username",
        "$ATTENDEE_USERNAME",
        "--request-id",
        "$INVITE_REQUEST_ID",
        "--format",
        "json"
      ]
    },
    {
      "identity": "attendee",
      "args": ["invites", "members", "get", "$INVITE_ID", "--format", "json"]
    },
    {
      "identity": "attendee",
      "args": ["invites", "members", "accept", "$INVITE_ID", "--format", "json"]
    },
    {
      "identity": "attendee",
      "args": [
        "events",
        "rsvp",
        "set",
        "$EVENT_ID",
        "--status",
        "YES",
        "--format",
        "json"
      ]
    },
    {
      "identity": "organizer",
      "args": ["events", "members", "$EVENT_ID", "--all", "--format", "json"]
    }
  ],
  "invite-lists": [
    {
      "identity": "organizer",
      "args": [
        "invite-lists",
        "people",
        "--search",
        "$ATTENDEE_USERNAME",
        "--format",
        "json"
      ]
    },
    {
      "identity": "organizer",
      "args": [
        "invite-lists",
        "create",
        "--name",
        "Dinner guests",
        "--person-ids",
        "$INVITE_LIST_PERSON_IDS",
        "--format",
        "json"
      ]
    },
    {
      "identity": "organizer",
      "args": ["invite-lists", "list", "--format", "json"]
    },
    {
      "identity": "organizer",
      "args": ["invite-lists", "get", "$INVITE_LIST_ID", "--format", "json"]
    },
    {
      "identity": "organizer",
      "args": [
        "invite-lists",
        "edit",
        "$INVITE_LIST_ID",
        "--name",
        "Weekend guests",
        "--format",
        "json"
      ]
    },
    {
      "identity": "organizer",
      "args": [
        "invite-lists",
        "invite",
        "$INVITE_LIST_ID",
        "--event",
        "$EVENT_ID",
        "--request-id",
        "$INVITE_LIST_REQUEST_ID",
        "--format",
        "json"
      ]
    },
    {
      "identity": "organizer",
      "args": [
        "invite-lists",
        "delete",
        "$INVITE_LIST_ID",
        "--yes",
        "--format",
        "json"
      ]
    }
  ],
  "inspection": [
    {
      "identity": "organizer",
      "args": ["auth", "status", "--format", "json"]
    },
    {
      "identity": "organizer",
      "args": ["events", "list", "--limit", "20", "--format", "json"]
    },
    {
      "identity": "organizer",
      "args": ["events", "get", "$EVENT_ID", "--format", "json"]
    },
    {
      "identity": "attendee",
      "args": ["events", "rsvp", "get", "$EVENT_ID", "--format", "json"]
    }
  ],
  "event-ownership-transfer": [
    {
      "identity": "organizer",
      "args": [
        "events",
        "transfer",
        "offer",
        "$EVENT_ID",
        "$RECIPIENT_PERSON_ID",
        "--yes"
      ]
    },
    {
      "identity": "attendee",
      "args": ["events", "transfer", "status", "$EVENT_ID"]
    },
    {
      "identity": "attendee",
      "args": [
        "events",
        "transfer",
        "accept",
        "$EVENT_ID",
        "$TRANSFER_ID",
        "--yes"
      ]
    },
    {
      "identity": "organizer",
      "args": ["events", "transfer", "status", "$EVENT_ID"]
    }
  ]
}
