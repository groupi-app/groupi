# Copy this file to packages/mobile/.env.local. Expo automatically loads it
# when commands are run from the mobile package.

# Public Convex deployment used by the native client.
EXPO_PUBLIC_CONVEX_URL=https://your-deployment.convex.cloud

# Web origin that hosts Better Auth. The iOS Simulator can reach services on
# the Mac through localhost; physical devices need a LAN or public HTTPS URL.
EXPO_PUBLIC_BETTER_AUTH_URL=http://localhost:3000

# Expo project UUID from https://expo.dev. Native push registration requires it.
EAS_PROJECT_ID=00000000-0000-0000-0000-000000000000
