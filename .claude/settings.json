{
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/scripts/guard-bash.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "pnpm exec prettier --write $FILE_PATH 2>/dev/null || true"
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "if": "*.tsx",
        "hooks": [
          {
            "type": "command",
            "command": "pnpm lint:tokens 2>&1 | tail -10"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/scripts/changeset-reminder.sh"
          }
        ]
      }
    ]
  }
}
