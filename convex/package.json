{
  "name": "@groupi/convex",
  "version": "0.4.0",
  "private": true,
  "license": "GPL-3.0",
  "description": "Convex backend functions and tests for Groupi",
  "scripts": {
    "build": "pnpm --dir .. generate",
    "type-check": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "test": "vitest run",
    "test:run": "pnpm codegen && vitest run",
    "test:watch": "pnpm codegen && vitest --watch",
    "test:no-codegen": "vitest run",
    "test:watch-no-codegen": "vitest --watch",
    "dev": "cd .. && pnpx convex dev",
    "codegen": "pnpm --dir .. generate"
  },
  "dependencies": {
    "@better-auth/api-key": "^1.6.13",
    "@better-auth/expo": "^1.6.13",
    "@better-auth/passkey": "^1.6.13",
    "@convex-dev/better-auth": "^0.12.2",
    "@convex-dev/resend": "^0.2.3",
    "@hono/swagger-ui": "^0.5.3",
    "@hono/zod-openapi": "^1.2.0",
    "better-auth": "^1.6.2",
    "expo-server-sdk": "^7.1.0",
    "hono": "^4.12.18",
    "resend": "^4.0.0",
    "@groupi/shared": "workspace:*",
    "oidc-provider": "9.12.2",
    "fetch-to-node": "2.1.0",
    "jose": "6.2.12",
    "zod": "^4.4.3",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@edge-runtime/vm": "^5.0.0",
    "convex": "^1.43.0",
    "convex-test": "^0.0.41",
    "typescript": "^5.9.3",
    "vitest": "^4.0.0",
    "@types/oidc-provider": "9.12.1",
    "@types/node": "^24.9.2"
  }
}
